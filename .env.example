DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
LLM_PROVIDER=gemini
LLM_API_KEY=
# Flash for answers, Flash-Lite for perturbation runs; check the current names in Google AI Studio.
LLM_ANSWER_MODEL=gemini-3.8-flash
LLM_LIGHT_MODEL=gemini-3.5-flash-lite
# Seconds before a Gemini call gives up (sent to Google as the request deadline).
LLM_TIMEOUT_S=60
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Ingestion: chunk size/overlap in characters; uploads land in UPLOAD_DIR (relative to backend/).
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=50
UPLOAD_DIR=data/uploads
# Retrieval: hits returned, candidates per search (keyword, vector) before fusion, RRF constant.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
RRF_K=60
# Agent: max sub-questions for multi-step questions; max passages given to the answer model.
AGENT_MAX_SUB_QUESTIONS=4
AGENT_MAX_PASSAGES=10
# Perturbation inspector: cosine similarity treated as "unrelated answers"; weight of the
# drop-cited signal in the score (0 = shown but not scored); model calls in flight at once.
DIAGNOSTICS_SIMILARITY_FLOOR=0.7
DIAGNOSTICS_DROP_CITED_WEIGHT=0
DIAGNOSTICS_CONCURRENCY=2
# Browser origins allowed to call the API (comma-separated): the frontend's URL(s).
CORS_ORIGINS=http://localhost:3000
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paper-rag
LANGSMITH_TRACING=false
